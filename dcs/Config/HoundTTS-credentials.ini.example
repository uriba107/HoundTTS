; ============================================================
; HoundTTS Credentials & Paths
; Copy this file to: Saved Games\DCS\Config\HoundTTS-credentials.ini
; and fill in the values you need. All settings are optional.
;
; This file is read directly by HoundTTS.dll (never by Lua).
; Credentials set here never appear in DCS logs or mission scripts.
; All settings are optional — leave blank to use bundled defaults.
; ============================================================

[Piper]
; Path to the piper binary directory (containing piper.dll or piper.exe)
; Leave blank to use bundled bin\piper\ folder (from the piper-engine package).
path =
; Path to folder containing .onnx voice model files
; Leave blank to use bundled voices\ folder
voice_path =
; Max number of concurrent piper synthesizers running at the same time
; (GLOBAL across ALL voices, not per-voice). Protects against ORT/memory
; exhaustion and crashes under burst load (e.g. 9 TTS calls in a row).
; Excess requests queue and start as soon as a slot frees up.
; Default: 4
max_concurrent = 4

[Google]
; Path to a Google Cloud service-account JSON file.
; Download from: Google Cloud Console → IAM & Admin → Service Accounts → Keys → Add Key → JSON
; The service account must have the "Cloud Text-to-Speech API User" role.
; Paths with spaces are fine — do NOT wrap in quotes (they are stripped automatically if present).
; Example: credentials_file = E:\Dropbox\Mission Building\googletts.json
credentials_file =

[Azure]
; Azure Cognitive Services Speech subscription key
key =
; Azure region (see https://learn.microsoft.com/azure/cognitive-services/speech-service/regions)
region =

[ElevenLabs]
; ElevenLabs API key (from https://elevenlabs.io/app/settings/api-keys)
api_key =
; ElevenLabs model ID (default: eleven_turbo_v2)
model_id = eleven_turbo_v2
; Note: voice_id is set per-call via provider_params.voice in Lua

[AWS]
; AWS access key ID (from IAM user with polly:SynthesizeSpeech and translate:TranslateText permissions)
access_key =
; AWS secret access key
secret_key =
; AWS region e.g. us-east-1, eu-west-1, ap-southeast-1
region =
; Polly voice engine: standard (default), neural, long-form
; standard is free tier (5M chars/month for 12 months); neural is paid
engine = standard
; Note: voice_id is set per-call via provider_params.voice in Lua
; If voice is not set, a default voice is chosen based on culture + gender
; Used by: TTS provider="aws" (or "polly"), Translation provider="aws"

[OpenAI]
; OpenAI API key (from https://platform.openai.com/api-keys)
; Optional for local deployments (e.g. LocalAI)
api_key =
; Base URL of the TTS endpoint. /v1/audio/speech is always appended.
; Any path is kept as a prefix (e.g. https://front.example.com/localai → /localai/v1/audio/speech)
; Default: https://api.openai.com
endpoint = https://api.openai.com
; Model name — e.g. tts-1, gpt-4o-mini-tts, pocket-tts, qwen-tts
model = tts-1
; Chat model used for translation (HoundTTS.Translate)
; e.g. gpt-4o-mini, gpt-4o, gpt-3.5-turbo
chat_model = gpt-4o-mini
; Note: voice is set per-call via provider_params.voice in Lua
; OpenAI voices: alloy, ash, coral, echo, fable, onyx, nova, sage, shimmer
; LocalAI voices depend on the backend (e.g. pocket-tts: alba, azelma, etc.)

[LibreTranslate]
; Base URL of your LibreTranslate instance (https://github.com/LibreTranslate/LibreTranslate)
; Works with self-hosted instances or public ones (e.g. https://libretranslate.com)
; Default: http://localhost:5000
endpoint = http://localhost:5000
; API key — leave blank for instances that don't require one
; Public libretranslate.com requires an API key; self-hosted typically does not
api_key =

[Supertonic]
; Path to supertonic binary directory (containing supertonic.dll)
; Leave blank to use bundled bin\supertonic\ folder (from the supertonic-engine package).
path =
; Path to ONNX models directory (*.onnx, tts.json, unicode_indexer.json)
; Leave blank to use bundled bin\supertonic\models\ folder
model_path =
; Voice style JSON name (without .json). Resolved from voice_style_path.
; Default: M1
voice_style = M1
; Directory containing voice style JSON files
; Leave blank to use bundled bin\supertonic\voice_styles\
voice_style_path =
; Default language code (e.g. en, ko, ja, de, fr, es, pt, ru, ar, etc.)
; Can be overridden per-call via provider_params.culture in Lua
lang = en
; Number of denoising diffusion steps (higher = better quality, slower)
; Default: 8
total_steps = 8
; Speech speed multiplier (> 1 = faster, < 1 = slower). Default: 1.05
speed = 1.05
; Max CPU threads for ONNX Runtime (per context). Default: 4
threads = 4
; Max concurrent syntheses (protects against CPU exhaustion). Default: 2
max_concurrent = 2

[Edge]
; Microsoft Edge Read Aloud TTS — FREE, no API key or account required.
; Uses Microsoft Edge's built-in text-to-speech service over WebSocket.
; Same high-quality neural voices as Azure Cognitive Services.
;
; UNOFFICIAL: This uses a reverse-engineered endpoint. Microsoft may change
; or block it at any time. No SLA or guarantees. If it stops working,
; switch to another provider (e.g. piper, sapi, or azure with a key).
;
; No configuration needed — just set provider = "edge" in your Lua script.
; Voice is set per-call via provider_params.voice (e.g. "en-US-AriaNeural").
; If voice is not set, defaults are chosen from culture + gender:
;   female → {culture}-AriaNeural   (e.g. en-US-AriaNeural)
;   male   → {culture}-GuyNeural    (e.g. en-US-GuyNeural)
;
; Full voice list: https://speech.platform.bing.com/consumer/speech/synthesize/
;   readaloud/voices/list?trustedclienttoken=6A5AA1D4EAFF4E9FB37E23D68491D6F4
;
; Pre-buffer milliseconds: audio is accumulated before streaming to smooth out
; network jitter. Increase if playback is choppy (e.g. high-latency regions).
; Range: 0–5000 (default: 200). Set to 0 to disable pre-buffering.
buffer_ms = 200

[Discord]
; Discord bot token — reserved for future D++ Discord voice backend
bot_token =

[General]
; Log level written to Logs\HoundTTS.log
; error  — only errors (default, recommended for production)
; info   — errors + connection/stream events
; debug  — everything including per-call argument traces (verbose)
log_level = error
; PCM cache: caches synthesised audio so repeat identical requests replay
; from memory instead of re-generating. Automatically flushed on mission end.
; cache_enabled: true/false (default: true)
cache_enabled = true
; Maximum cache size in megabytes (default: 100)
cache_max_mb = 100
; Time-to-live in minutes since last access; entries not hit within this
; window are evicted. 0 = no TTL (entries only evicted by LRU/size cap).
; Default: 5
cache_ttl_minutes = 5
