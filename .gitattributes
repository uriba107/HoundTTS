# Normalise all text files to LF in the repo and on checkout.
# macOS/Dropbox sync: keeps diffs clean regardless of local line endings.
# Git for Windows tools still handle LF transparently, and the build
# pipeline does not require CRLF-terminated sources.
* text=auto eol=lf

# Binary files — never touch
*.dll binary
*.exe binary
*.lib binary
*.onnx binary
*.png binary
*.ico binary
*.wav binary
