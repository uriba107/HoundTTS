# Windows container build — requires a Windows Docker host with Windows containers enabled.
# Produces the same /dist layout as the Linux/MinGW Dockerfile.
#
# Two-stage build:
#   deps  — Chocolatey + VS Build Tools + vcpkg + OpenSSL (~15 GB, cached after first run)
#   build — COPY source + compile + assemble dist (fast, runs on every code change)
#
# Usage (from PowerShell on the Windows host):
#   .\build-docker.ps1
#   docker run --rm -v C:\output:C:\output houndtts-builder-msvc

# ============================================================
# Stage 1: deps — all heavy toolchain installs, no source code
# ============================================================
FROM mcr.microsoft.com/dotnet/framework/runtime:4.8-windowsservercore-ltsc2019 AS deps

SHELL ["cmd", "/S", "/C"]

# Chocolatey
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
     iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))"

ARG CMAKE_VERSION=4.3.0
RUN choco install -y cmake --version %CMAKE_VERSION% --installargs "ADD_CMAKE_TO_PATH=System"

ARG GIT_VERSION=2.53.0
RUN choco install -y git --version %GIT_VERSION%

ARG WGET_VERSION=1.21.4
RUN choco install -y wget --version %WGET_VERSION%

ARG UNZIP_VERSION=6.0
RUN choco install -y unzip --version %UNZIP_VERSION%

ARG STRAWBERRYPERL_VERSION=5.38.2.2
RUN choco install -y strawberryperl --version %STRAWBERRYPERL_VERSION%

# Visual Studio 2022 Build Tools — MSVC v143 + Windows 10 SDK 19041 (sapi.h, sphelper.h, COM headers)
# Split into two layers to avoid hcsshim ImportLayer failure on large single layers
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "Invoke-WebRequest -Uri 'https://aka.ms/vs/17/release/vs_buildtools.exe' -OutFile 'C:\vs_buildtools.exe'"

RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$p = Start-Process -FilePath 'C:\vs_buildtools.exe' -Wait -PassThru -ArgumentList \
       '--quiet','--wait','--norestart','--nocache', \
       '--installPath','C:\BuildTools', \
       '--add','Microsoft.VisualStudio.Workload.VCTools', \
       '--add','Microsoft.VisualStudio.Component.VC.Tools.x86.x64', \
       '--add','Microsoft.VisualStudio.Component.Windows10SDK.19041'; \
     Remove-Item 'C:\vs_buildtools.exe'; \
     if ($p.ExitCode -ne 0) { throw \"vs_buildtools.exe exited with code $($p.ExitCode)\" }"

# vcpkg — classic mode install (no vcpkg.json manifest; version pinned via VCPKG_TAG)
ARG VCPKG_TAG=2026.03.18
RUN git clone --branch %VCPKG_TAG% --depth 1 https://github.com/microsoft/vcpkg.git C:\\vcpkg && \
    C:\\vcpkg\\bootstrap-vcpkg.bat -disableMetrics
# Install packages — versions determined by the pinned vcpkg tag's built-in baseline
RUN C:\\vcpkg\\vcpkg.exe install openssl:x64-windows-static opus:x64-windows-static && \
    C:\\vcpkg\\vcpkg.exe integrate install

ARG HTTPLIB_VERSION=v0.38.0
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force C:\deps\include | Out-Null; \
     Invoke-WebRequest -Uri ('https://raw.githubusercontent.com/yhirose/cpp-httplib/' + $env:HTTPLIB_VERSION + '/httplib.h') \
     -OutFile 'C:\deps\include\httplib.h'"

# Voice models (large downloads, cache here — used by piper stage)
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$hf = 'https://huggingface.co/rhasspy/piper-voices/resolve/main'; \
     New-Item -ItemType Directory -Force -Path 'C:\deps\voices' | Out-Null; \
     @( \
       'en/en_US/lessac/low/en_US-lessac-low.onnx', \
       'en/en_US/lessac/low/en_US-lessac-low.onnx.json', \
       'en/en_US/ryan/low/en_US-ryan-low.onnx', \
       'en/en_US/ryan/low/en_US-ryan-low.onnx.json' \
     ) | ForEach-Object { \
       $file = Split-Path $_ -Leaf; \
       Invoke-WebRequest -Uri \"$hf/$_\" -OutFile \"C:\deps\voices\$file\" \
     }"


# ============================================================
# Stage 2: piper — clone piper1-gpl + compile piper.dll from source
#           Runs in parallel with the build stage (independent FROM deps)
#           espeak-ng + onnxruntime are auto-fetched by libpiper's CMakeLists
# ============================================================
FROM deps AS piper

ARG PIPER1_GPL_TAG=v1.4.1
RUN git clone --branch %PIPER1_GPL_TAG% --depth 1 \
    https://github.com/OHF-Voice/piper1-gpl.git C:\piper1-gpl

# Patch piper for onnxruntime 1.22.0 API + DLL-safe init (see patch_piper.ps1)
# PIPER_PATCH_VER is a cache-buster: bump in deps.env to force this layer to rebuild.
ARG PIPER_PATCH_VER=1
COPY tools/patch_piper.ps1 C:/tools/
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:\tools\patch_piper.ps1


# Pre-download onnxruntime 1.22.0
# Place it where libpiper's CMakeLists expects ONNXRUNTIME_DIR
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$url = 'https://github.com/microsoft/onnxruntime/releases/download/v1.22.0/onnxruntime-win-x64-1.22.0.zip'; \
     $zip = 'C:\ort.zip'; \
     Invoke-WebRequest -Uri $url -OutFile $zip; \
     Expand-Archive -Path $zip -DestinationPath 'C:\ort'; \
     Remove-Item $zip"

# Build libpiper: auto-clones espeak-ng (ExternalProject_Add); use pre-downloaded onnxruntime
# Phase 1: configure + build espeak-ng only
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake -S C:\piper1-gpl\libpiper -B C:\piper1-build \
      -G "NMake Makefiles" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=C:\piper1-install \
      -DONNXRUNTIME_DIR=C:/ort/onnxruntime-win-x64-1.22.0 \
      -DCMAKE_WINDOWS_EXPORT_ALL_SYMBOLS=ON \
      "-DCMAKE_CXX_FLAGS=/DESPEAK_API= /utf-8" && \
    cmake --build C:\piper1-build --target espeak_ng_external

# Phase 2: patch espeak-ng installed header — replace __declspec(dllimport)
#           with empty ESPEAK_API so piper links statically against espeak-ng
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$h = 'C:\piper1-build\espeak_ng-install\include\espeak-ng\speak_lib.h'; \
     $c = [System.IO.File]::ReadAllText($h); \
     $c = $c.Replace('__declspec(dllimport)', ''); \
     [System.IO.File]::WriteAllText($h, $c); \
     Write-Host 'speak_lib.h patched OK'"

# Phase 3: build piper (espeak-ng already built, header patched)
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake --build C:\piper1-build --config Release && \
    cmake --install C:\piper1-build

# Assemble piper-addon dist
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force 'C:\dist\piper-addon\Mods\Services\HoundTTS\bin\piper' | Out-Null; \
     New-Item -ItemType Directory -Force 'C:\dist\piper-addon\Mods\Services\HoundTTS\voices' | Out-Null; \
     Copy-Item 'C:\piper1-install\piper.dll'                             'C:\dist\piper-addon\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item 'C:\piper1-install\lib\onnxruntime.dll'                  'C:\dist\piper-addon\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item -Recurse 'C:\piper1-install\espeak-ng-data'              'C:\dist\piper-addon\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item -Recurse -Force 'C:\deps\voices\*'                       'C:\dist\piper-addon\Mods\Services\HoundTTS\voices'"

# ============================================================
# Stage 3: build — copy source, compile, assemble dist/base
#           Rebuilds fast on code changes; deps layer is cached
# ============================================================
FROM deps AS build
ARG HOUNDTTS_VERSION=0.0.0
ARG HOUNDTTS_VERSION_FULL=

WORKDIR C:\\src
COPY . C:\\src\\

# Overlay httplib header from deps stage
RUN copy C:\\deps\\include\\httplib.h C:\\src\\include\\httplib.h

# Generate lua.lib from bundled lua.dll using PowerShell + full paths (no vcvars needed)
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:\src\make_lua_lib.ps1

# CMake configure
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake -S C:\src -B C:\build \
      -G "NMake Makefiles" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_TOOLCHAIN_FILE=C:\vcpkg\scripts\buildsystems\vcpkg.cmake \
      -DVCPKG_TARGET_TRIPLET=x64-windows-static \
      -DHOUNDTTS_VERSION_OVERRIDE=%HOUNDTTS_VERSION% \
      -DHOUNDTTS_VERSION_FULL=%HOUNDTTS_VERSION_FULL%

# Compile
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake --build C:\build --config Release

# Assemble dist/base
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force 'C:\dist\base\Mods\Services\HoundTTS\bin' | Out-Null; \
     New-Item -ItemType Directory -Force 'C:\dist\base\Mods\Services\HoundTTS\Scripts' | Out-Null; \
     New-Item -ItemType Directory -Force 'C:\dist\base\Mods\Services\HoundTTS\examples' | Out-Null; \
     New-Item -ItemType Directory -Force 'C:\dist\base\Scripts\Hooks' | Out-Null; \
     New-Item -ItemType Directory -Force 'C:\dist\base\Config' | Out-Null; \
     Copy-Item 'C:\build\bin\HoundTTS.dll'                                      'C:\dist\base\Mods\Services\HoundTTS\bin'; \
     Copy-Item 'C:\src\dcs\Mods\Services\HoundTTS\Scripts\HoundTTS.lua'         'C:\dist\base\Mods\Services\HoundTTS\Scripts'; \
     Copy-Item 'C:\src\dcs\Mods\Services\HoundTTS\Scripts\HoundTTS-mission.lua' 'C:\dist\base\Mods\Services\HoundTTS\Scripts'; \
     Copy-Item 'C:\src\dcs\Mods\Services\HoundTTS\examples\*'                   'C:\dist\base\Mods\Services\HoundTTS\examples'; \
     Copy-Item 'C:\src\dcs\Scripts\Hooks\HoundTTS-hook.lua'                     'C:\dist\base\Scripts\Hooks'; \
     Copy-Item 'C:\src\dcs\Config\HoundTTS-config.lua.example'                  'C:\dist\base\Config\HoundTTS.lua.example'; \
     Copy-Item 'C:\src\dcs\Config\HoundTTS-credentials.ini.example'             'C:\dist\base\Config\HoundTTS-credentials.ini.example'"

# ============================================================
# Stage 4: output — merge build + piper into final image
# ============================================================
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS output

COPY --from=build C:\\dist\\base         C:\\dist\\base
COPY --from=piper C:\\dist\\piper-addon  C:\\dist\\piper-addon

# Copy dist to C:\output on run
CMD xcopy /E /I /Y C:\\dist C:\\output
