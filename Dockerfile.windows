# Windows container build — requires a Windows Docker host with Windows containers enabled.
# Produces the same /dist layout as the Linux/MinGW Dockerfile.
#
# Multi-stage build:
#   deps  — Chocolatey + VS Build Tools + vcpkg + OpenSSL (~15 GB, cached after first run)
#   piper — clone piper1-gpl + compile piper.dll
#   build — COPY source + compile + assemble dist (fast, runs on every code change)
#
# Usage (from PowerShell on the Windows host):
#   .\build-docker.ps1
#   docker run --rm -v C:\output:C:\output houndtts-builder-msvc

# ============================================================
# Stage 1: deps — all heavy toolchain installs, no source code
# ============================================================
FROM mcr.microsoft.com/dotnet/framework/runtime:4.8-windowsservercore-ltsc2022 AS deps

SHELL ["cmd", "/S", "/C"]

# Chocolatey
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "[System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; \
     iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))"

ARG CMAKE_VERSION=4.3.2
ARG GIT_VERSION=2.54.0
ARG WGET_VERSION=1.21.4
ARG UNZIP_VERSION=6.0

RUN choco install -y cmake --version %CMAKE_VERSION% --installargs "ADD_CMAKE_TO_PATH=System" && \
    choco install -y git --version %GIT_VERSION% && \
    choco install -y wget --version %WGET_VERSION% && \
    choco install -y unzip --version %UNZIP_VERSION% 

# Visual Studio 2022 Build Tools — MSVC v143 + Windows 10 SDK 19041 (sapi.h, sphelper.h, COM headers)
# Uses aka.ms redirect (always points to latest VS 2022 Build Tools). Pinned URLs
# expire — Microsoft rotates content-hashed download links periodically.
# Component set locked via --add flags; only VCTools workload + SDK needed.
# Split into two layers to avoid hcsshim ImportLayer failure on large single layers
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "Invoke-WebRequest -Uri 'https://aka.ms/vs/17/release/vs_buildtools.exe' -OutFile 'C:\vs_buildtools.exe'"

RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$p = Start-Process -FilePath 'C:\vs_buildtools.exe' -Wait -PassThru -ArgumentList \
       '--quiet','--wait','--norestart','--nocache', \
       '--installPath','C:\BuildTools', \
       '--add','Microsoft.VisualStudio.Workload.VCTools', \
       '--add','Microsoft.VisualStudio.Component.VC.Tools.x86.x64', \
       '--add','Microsoft.VisualStudio.Component.Windows10SDK.19041'; \
     Remove-Item 'C:\vs_buildtools.exe'; \
     if ($p.ExitCode -ne 0 -and $p.ExitCode -ne 3010) { throw \"vs_buildtools.exe exited with code $($p.ExitCode)\" }"

# Ninja build system for parallel compilation
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$url = 'https://github.com/ninja-build/ninja/releases/download/v1.12.1/ninja-win.zip'; \
     $zip = 'C:\ninja.zip'; \
     Invoke-WebRequest -Uri $url -OutFile $zip; \
     Expand-Archive -Path $zip -DestinationPath 'C:\BuildTools\bin' -Force; \
     Remove-Item $zip"
RUN powershell -NoProfile -Command \
    "$mp = [Environment]::GetEnvironmentVariable('PATH','Machine'); \
     [Environment]::SetEnvironmentVariable('PATH', $mp + ';C:\BuildTools\bin', 'Machine')"

# vcpkg — classic mode install (no vcpkg.json manifest; version pinned via VCPKG_TAG)
# Install packages — versions determined by the pinned vcpkg tag's built-in baseline
ARG VCPKG_TAG=2026.06.01
RUN git clone --branch %VCPKG_TAG% --depth 1 https://github.com/microsoft/vcpkg.git C:\\vcpkg && \
    C:\\vcpkg\\bootstrap-vcpkg.bat -disableMetrics && \
    C:\\vcpkg\\vcpkg.exe install openssl:x64-windows-static opus:x64-windows-static nlohmann-json:x64-windows-static && \
    C:\\vcpkg\\vcpkg.exe integrate install

ARG HTTPLIB_VERSION=v0.48.0
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force C:\deps\include | Out-Null; \
     Invoke-WebRequest -Uri ('https://raw.githubusercontent.com/yhirose/cpp-httplib/' + $env:HTTPLIB_VERSION + '/httplib.h') \
     -OutFile 'C:\deps\include\httplib.h'"


# Pre-download onnxruntime (GitHub release, HTTPS integrity)
# Place it where libpiper's CMakeLists expects ONNXRUNTIME_DIR
# Uses wget (already installed via Chocolatey) because its built-in retry is
# more resilient against GitHub's intermittent connection closures on CI.
ARG ONNXRUNTIME_VERSION=1.22.1
ARG ONNXRUNTIME_SHA256=855276cd4be3cda14fe636c69eb038d75bf5bcd552bda1193a5d79c51f436dfe
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$url    = 'https://github.com/microsoft/onnxruntime/releases/download/v' + $env:ONNXRUNTIME_VERSION + '/onnxruntime-win-x64-' + $env:ONNXRUNTIME_VERSION + '.zip'; \
     $zip    = 'C:\ort.zip'; \
     wget.exe --retry-connrefused --waitretry=3 --tries=5 -q \"$url\" -O \"$zip\"; \
     $expectedSha = [string]$env:ONNXRUNTIME_SHA256; \
     if ($expectedSha.Length -gt 0) { \
       $actualSha = (Get-FileHash -Path $zip -Algorithm SHA256).Hash.ToLower(); \
       if ($actualSha -ne $expectedSha.ToLower()) { \
         Write-Host \"SHA256 mismatch for onnxruntime.zip. Expected: $expectedSha, Actual: $actualSha\"; \
         Remove-Item $zip; \
         exit 1; \
       } \
       Write-Host \"SHA256 checksum verified.\"; \
     } \
     Expand-Archive -Path $zip -DestinationPath 'C:\ort-tmp'; \
     Move-Item (Get-Item 'C:\ort-tmp\onnxruntime-*').FullName 'C:\ort'; \
     Remove-Item 'C:\ort-tmp' -Recurse -Force; \
     Remove-Item $zip"

# Voice models (large downloads, cache here — used by piper stage)
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$hf = 'https://huggingface.co/rhasspy/piper-voices/resolve/main'; \
     New-Item -ItemType Directory -Force -Path 'C:\deps\voices' | Out-Null; \
     @( \
       'en/en_US/lessac/low/en_US-lessac-low.onnx', \
       'en/en_US/lessac/low/en_US-lessac-low.onnx.json', \
       'en/en_US/ryan/low/en_US-ryan-low.onnx', \
       'en/en_US/ryan/low/en_US-ryan-low.onnx.json' \
     ) | ForEach-Object { \
       $file = Split-Path $_ -Leaf; \
       Invoke-WebRequest -Uri \"$hf/$_\" -OutFile \"C:\deps\voices\$file\" \
     }"


# ============================================================
# Stage 2: piper — clone piper1-gpl + compile piper.dll from source
#           Runs in parallel with the build stage (independent FROM deps)
#           espeak-ng + onnxruntime are auto-fetched by libpiper's CMakeLists
# ============================================================
FROM deps AS piper

ARG PIPER1_GPL_TAG=v1.6.1
RUN git clone --branch %PIPER1_GPL_TAG% --depth 1 \
    https://github.com/OHF-Voice/piper1-gpl.git C:\piper1-gpl

# Build libpiper: auto-clones espeak-ng (ExternalProject_Add); use pre-downloaded onnxruntime
# Phase 1: configure + build espeak-ng only
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake -S C:\piper1-gpl\libpiper -B C:\piper1-build \
      -G "Ninja" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=C:\piper1-install \
      -DONNXRUNTIME_DIR=C:/ort \
      "-DCMAKE_CXX_FLAGS=/DESPEAK_API= /DWIN32 /utf-8" && \
    cmake --build C:\piper1-build --parallel --target espeak_ng_external

# Phase 2: build piper (espeak-ng already built)
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake --build C:\piper1-build --parallel --config Release && \
    cmake --install C:\piper1-build && \
    rmdir /S /Q C:\piper1-build

# Assemble piper-engine dist (DLLs + espeak-ng-data + license — ~16 MB)
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force 'C:\dist\piper-engine\Mods\Services\HoundTTS\bin\piper' | Out-Null; \
     Copy-Item 'C:\piper1-install\piper.dll'                             'C:\dist\piper-engine\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item 'C:\piper1-install\lib\onnxruntime.dll'                  'C:\dist\piper-engine\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item -Recurse 'C:\piper1-install\espeak-ng-data'              'C:\dist\piper-engine\Mods\Services\HoundTTS\bin\piper'; \
     Copy-Item 'C:\piper1-gpl\COPYING'                                    'C:\dist\piper-engine\Mods\Services\HoundTTS\bin\piper\COPYING'"

# Assemble piper-voices dist (bundled voice models — ~120 MB)
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "New-Item -ItemType Directory -Force 'C:\dist\piper-voices\Mods\Services\HoundTTS\voices' | Out-Null; \
     Copy-Item -Recurse -Force 'C:\deps\voices\*'                       'C:\dist\piper-voices\Mods\Services\HoundTTS\voices'"

# ============================================================
# Stage 2b: supertonic — clone supertonic + compile supertonic.dll
#            Shares onnxruntime with piper (same ORT 1.22.0)
# ============================================================
FROM deps AS supertonic

ARG SUPERTONIC_TAG=5379cc4e4297cec249a8a71283fc44d55ec327f1
RUN git init C:\supertonic \
    && cd C:\supertonic \
    && git remote add origin https://github.com/supertone-inc/supertonic.git \
    && git fetch --depth 1 origin %SUPERTONIC_TAG% \
    && git checkout FETCH_HEAD

# Patch helper.cpp for ORT 1.22.0 (Session constructor char* -> wchar_t*)
COPY tools/patch_supertonic.ps1 C:/tools/
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:\tools\patch_supertonic.ps1

# Copy our C API wrapper + CMakeLists
COPY tools/supertonic_api.cpp C:/tools/supertonic_api.cpp
COPY tools/supertonic_cmake/CMakeLists.txt C:/tools/supertonic_cmake/CMakeLists.txt
COPY include/supertonic/ C:/src_include/supertonic/

# Build supertonic.dll
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake -S C:\tools\supertonic_cmake -B C:\supertonic-build \
      -G "Ninja" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_TOOLCHAIN_FILE=C:\vcpkg\scripts\buildsystems\vcpkg.cmake \
      -DVCPKG_TARGET_TRIPLET=x64-windows-static \
      -DONNXRUNTIME_DIR=C:/ort \
      -DSUPERTONIC_SRC_DIR=C:/supertonic/cpp \
      -DSUPERTONIC_API_CPP=C:/tools/supertonic_api.cpp \
      -DSUPERTONIC_INCLUDE=C:/src_include && \
    cmake --build C:\supertonic-build --parallel

# Download ONNX models + voice styles from HuggingFace (pinned commit for caching)
ARG SUPERTONIC_ASSETS_HASH=3cadd1ee6394adea1bd021217a0e650ede09a323
RUN git lfs install \
    && git init C:\supertonic-assets \
    && cd C:\supertonic-assets \
    && git remote add origin https://huggingface.co/Supertone/supertonic-3 \
    && git fetch --depth 1 origin %SUPERTONIC_ASSETS_HASH% \
    && git checkout FETCH_HEAD

# Assemble supertonic-engine dist (DLL + onnxruntime + models + voice_styles — all in bin/supertonic/)
RUN powershell -NoProfile -ExecutionPolicy Bypass -Command \
    "$base = 'C:\dist\supertonic-engine\Mods\Services\HoundTTS\bin\supertonic'; \
     New-Item -ItemType Directory -Force $base | Out-Null; \
     Copy-Item 'C:\supertonic-build\supertonic.dll'                    $base; \
     Copy-Item 'C:\ort\lib\onnxruntime.dll'                        $base; \
     Copy-Item -Recurse 'C:\supertonic-assets\onnx'                    \"$base\models\"; \
     Copy-Item -Recurse 'C:\supertonic-assets\voice_styles'            \"$base\voice_styles\""


# ============================================================
# Stage 3: build — copy source, compile, assemble dist/base
#           Rebuilds fast on code changes; deps layer is cached
# ============================================================
FROM deps AS build
ARG HOUNDTTS_VERSION=0.0.0

WORKDIR C:\\src
COPY CMakeLists.txt C:/src
COPY make_lua_lib.ps1 C:/src
COPY src/ C:/src/src
COPY include/ C:/src/include
COPY lib/ C:/src/lib

# Overlay httplib header from deps stage
RUN copy C:\\deps\\include\\httplib.h C:\\src\\include\\httplib.h

# Generate lua.lib from bundled lua.dll using PowerShell + full paths (no vcvars needed)
RUN powershell -NoProfile -ExecutionPolicy Bypass -File C:\src\make_lua_lib.ps1

# CMake configure
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake -S C:\src -B C:\build \
      -G "Ninja" \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_TOOLCHAIN_FILE=C:\vcpkg\scripts\buildsystems\vcpkg.cmake \
      -DVCPKG_TARGET_TRIPLET=x64-windows-static \
      -DHOUNDTTS_VERSION_OVERRIDE=%HOUNDTTS_VERSION%

# Compile (parallel build uses all available cores)
RUN C:\BuildTools\VC\Auxiliary\Build\vcvars64.bat && \
    cmake --build C:\build --parallel

# ============================================================
# Stage 4: base-output — package just the base package (DLL + Lua + config)
#           Independent of piper/supertonic, for parallel CI builds
# ============================================================
FROM mcr.microsoft.com/windows/nanoserver:ltsc2022 AS base-output

# Compiled DLL from build stage
COPY --from=build C:\\build\\bin\\HoundTTS.dll  C:\\dist\\base\\Mods\\Services\\HoundTTS\\bin\\HoundTTS.dll

# Lua scripts + config from build context
COPY dcs/Mods/Services/HoundTTS/Scripts/             C:/dist/base/Mods/Services/HoundTTS/Scripts
COPY dcs/Mods/Services/HoundTTS/examples/            C:/dist/base/Mods/Services/HoundTTS/examples
COPY dcs/Scripts/Hooks/HoundTTS-hook.lua              C:\\dist\\base\\Scripts\\Hooks\\HoundTTS-hook.lua
COPY dcs/Config/HoundTTS-config.lua.example           C:\\dist\\base\\Config\\HoundTTS.lua.example
COPY dcs/Config/HoundTTS-credentials.ini.example      C:\\dist\\base\\Config\\HoundTTS-credentials.ini.example

# ============================================================
# Stage 5: output — merge all packages into final image
#           Uses nanoserver (minimal) since we only copy files
# ============================================================
FROM mcr.microsoft.com/windows/nanoserver:ltsc2022 AS output

# Base package from base-output stage
COPY --from=base-output C:\\dist\\base C:\\dist\\base

# Piper engine + voices from piper stage
COPY --from=piper C:\\dist\\piper-engine   C:\\dist\\piper-engine
COPY --from=piper C:\\dist\\piper-voices   C:\\dist\\piper-voices

# Supertonic engine (DLL + onnxruntime + models + voice_styles) from supertonic stage
COPY --from=supertonic C:\\dist\\supertonic-engine   C:\\dist\\supertonic-engine

# Copy dist to C:\output on run
CMD xcopy /E /I /Y C:\\dist C:\\output
